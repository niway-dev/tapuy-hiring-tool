# Database
DATABASE_URL=
DATABASE_URL_DIRECT=

# Better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Comma-separated. Better Auth rejects any browser request whose Origin is not
# listed here. Include every client you run locally:
#   web (React) :3001, angular-web :4200, web-stylex :3002
CORS_ORIGIN=http://localhost:3001,http://localhost:4200,http://localhost:3002
